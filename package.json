    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "mongodb": "^7.6.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}