{
  "name": "@dev-waren/mongodb",
  "version": "1.0.3",
  "description": "Declarative MongoDB client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
