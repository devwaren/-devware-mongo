    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}