{
  "name": "@dev-waren/mongodb",
  "version": "1.0.31",
  "description": "A declarative MongoDB utility package built on the official MongoDB Node.js driver.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
